{
  "name": "gitmove-v2",
  "version": "0.10.2",
  "private": true,
  "description": "gitmove v2 desktop shell (Electron + Vue, Rust core later)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron . --smoke",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "pinia": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.myloveou.gitmove",
    "productName": "gitmove",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/gitmove-core.exe",
        "to": "core/gitmove-core.exe"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3"
  }
}
